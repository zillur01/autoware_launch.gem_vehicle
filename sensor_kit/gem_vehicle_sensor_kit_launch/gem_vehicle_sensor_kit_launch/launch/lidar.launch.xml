<launch>
  <arg name="launch_driver" default="true"/>
  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="crop_box_filter_self_param_path" default="$(find-pkg-share gem_vehicle_sensor_kit_launch)/config/crop_box_filter_self.param.yaml"/>
  <arg name="crop_box_filter_mirror_param_path" default="$(find-pkg-share gem_vehicle_sensor_kit_launch)/config/crop_box_filter_mirror.param.yaml"/>
  <arg name="ouster_params_file" default="$(find-pkg-share gem_vehicle_sensor_kit_launch)/config/ouster/driver_params.yaml"/>
  <arg name="livox_config_path" default="$(find-pkg-share gem_vehicle_sensor_kit_launch)/config/livox/HAP_config.json"/>

  <group>
    <push-ros-namespace namespace="lidar"/>

    <!-- Top: Ouster OS1-64 (sensor_hostname and frames are set in config/ouster/driver_params.yaml) -->
    <group>
      <push-ros-namespace namespace="top"/>
      <let name="target_container" value="/sensing/lidar/top/pointcloud_preprocessor/pointcloud_container"/>

      <include file="$(find-pkg-share autoware_sensing_launch)/launch/pointcloud_container.launch.xml">
        <arg name="container_namespace" value="/sensing/lidar/top/pointcloud_preprocessor"/>
        <arg name="container_name" value="pointcloud_container"/>
        <arg name="use_multithread" value="true"/>
      </include>

      <group if="$(var launch_driver)">
        <include file="$(find-pkg-share gem_vehicle_sensor_kit_launch)/launch/ouster_driver.launch.py">
          <arg name="ouster_params_file" value="$(var ouster_params_file)"/>
        </include>
      </group>

      <!-- Crop boxes only: the distortion corrector and ring outlier filter need the Autoware point layout (channel, azimuth, distance, ...), which the Ouster driver does not publish -->
      <include file="$(find-pkg-share autoware_sensing_launch)/launch/pointcloud_crop_boxes.launch.xml">
        <arg name="target_container" value="$(var target_container)"/>
        <arg name="use_intra_process" value="true"/>
        <arg name="output/pointcloud" value="pointcloud_before_sync"/>
        <arg name="crop_box_filter_self_param_path" value="$(var crop_box_filter_self_param_path)"/>
        <arg name="crop_box_filter_secondary_param_path" value="$(var crop_box_filter_mirror_param_path)"/>
      </include>
    </group>

    <!-- Front: Livox HAP (lidar/host IPs are set in config/livox/HAP_config.json) -->
    <group>
      <push-ros-namespace namespace="front"/>
      <let name="target_container" value="/sensing/lidar/front/pointcloud_preprocessor/pointcloud_container"/>

      <include file="$(find-pkg-share autoware_sensing_launch)/launch/pointcloud_container.launch.xml">
        <arg name="container_namespace" value="/sensing/lidar/front/pointcloud_preprocessor"/>
        <arg name="container_name" value="pointcloud_container"/>
        <arg name="use_multithread" value="false"/>
      </include>

      <group if="$(var launch_driver)">
        <node pkg="livox_ros_driver2" exec="livox_ros_driver2_node" name="livox_lidar_publisher" output="screen">
          <param name="xfer_format" value="0"/>
          <param name="multi_topic" value="0"/>
          <param name="data_src" value="0"/>
          <param name="publish_freq" value="10.0"/>
          <param name="output_data_type" value="0"/>
          <param name="frame_id" value="livox_lidar_link"/>
          <param name="lvx_file_path" value="/home/livox/livox_test.lvx"/>
          <param name="user_config_path" value="$(var livox_config_path)"/>
          <param name="cmdline_input_bd_code" value="livox0000000001"/>
          <remap from="livox/lidar" to="pointcloud_raw_ex"/>
        </node>
      </group>

      <!-- Crop boxes only: the Livox cloud has no ring/channel field, so the ring outlier filter cannot be used -->
      <include file="$(find-pkg-share autoware_sensing_launch)/launch/pointcloud_crop_boxes.launch.xml">
        <arg name="target_container" value="$(var target_container)"/>
        <arg name="use_intra_process" value="true"/>
        <arg name="output/pointcloud" value="pointcloud_before_sync"/>
        <arg name="crop_box_filter_self_param_path" value="$(var crop_box_filter_self_param_path)"/>
        <arg name="crop_box_filter_secondary_param_path" value="$(var crop_box_filter_mirror_param_path)"/>
      </include>
    </group>

    <include file="$(find-pkg-share autoware_sensing_launch)/launch/pointcloud_concatenation_cpu.launch.xml">
      <arg name="use_concat_filter" value="$(var use_concat_filter)"/>
      <arg name="use_intra_process" value="true"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <arg name="concatenate_and_time_sync_node_param_path" value="$(find-pkg-share gem_vehicle_sensor_kit_launch)/config/concatenate_and_time_sync_node.param.yaml"/>
    </include>
  </group>
</launch>
