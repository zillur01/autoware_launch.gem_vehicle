<launch>
  <arg name="launch_driver" default="true"/>
  <arg name="septentrio_config_file" default="$(find-pkg-share gem_vehicle_sensor_kit_launch)/config/septentrio/ins.yaml"/>

  <group>
    <push-ros-namespace namespace="gnss"/>

    <!-- The Septentrio driver publishes absolute topics (/navsatfix, /imu, /atteuler), so the pushed namespace does not move them -->
    <let name="navsatfix_topic_name" value="/navsatfix"/>
    <let name="atteuler_topic_name" value="/atteuler"/>

    <!-- Septentrio GNSS/INS driver -->
    <group if="$(var launch_driver)">
      <node_container pkg="rclcpp_components" exec="component_container" name="septentrio_gnss_driver_container" namespace="septentrio_gnss_driver" output="screen">
        <composable_node pkg="septentrio_gnss_driver" plugin="rosaic_node::ROSaicNode" name="septentrio_gnss_driver">
          <param from="$(var septentrio_config_file)"/>
        </composable_node>
      </node_container>
    </group>

    <!-- AttEuler heading to GnssInsOrientationStamped, then NavSatFix to MGRS pose -->
    <include file="$(find-pkg-share autoware_sensing_launch)/launch/gnss_postprocessor.launch.xml">
      <arg name="input/fix" value="$(var navsatfix_topic_name)"/>
      <arg name="input/atteuler" value="$(var atteuler_topic_name)"/>
      <arg name="output/pose" value="pose"/>
      <arg name="output/pose_with_covariance" value="pose_with_covariance"/>
      <arg name="output/fixed" value="fixed"/>
    </include>
  </group>
</launch>
