<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
    <xacro:include filename="$(find gem_description)/urdf/ouster/OS1-64.urdf.xacro"/>
    <xacro:include filename="$(find gem_vehicle_sensor_kit_description)/sensor/camera/urdf/monocular_camera.xacro"/>
    <xacro:include filename="$(find gem_vehicle_sensor_kit_description)/sensor/imu/urdf/imu.xacro"/>

    <xacro:arg name="gpu" default="false"/>
    <xacro:arg name="config_dir" default="$(find gem_vehicle_sensor_kit_description)/config"/>

    <xacro:property name="sensor_kit_base_link" default="sensor_kit_base_link"/>

    <joint name="${sensor_kit_base_link}_joint" type="fixed">
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
      <parent link="${parent}"/>
      <child link="${sensor_kit_base_link}"/>
    </joint>
    <link name="${sensor_kit_base_link}">
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </link>

    <!-- sensor -->
    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>

    <!-- lidar -->
    <xacro:OS1_64 parent="sensor_kit_base_link" name="os_sensor" topic_points="/ouster/points" topic_imu="/ouster/imu" hz="10" lasers="64" samples="512" min_range="0.9" max_range="75.0" noise="0.008" min_angle="-3.1415926" max_angle="3.1415926" lidar_link="os_lidar" imu_link="os_imu" vfov_min="-.26" vfov_max=".26">
      <origin
        xyz="${calibration['sensor_kit_base_link']['os_sensor']['x']}
             ${calibration['sensor_kit_base_link']['os_sensor']['y']}
             ${calibration['sensor_kit_base_link']['os_sensor']['z']}"
        rpy="${calibration['sensor_kit_base_link']['os_sensor']['roll']}
             ${calibration['sensor_kit_base_link']['os_sensor']['pitch']}
             ${calibration['sensor_kit_base_link']['os_sensor']['yaw']}"
      />
    </xacro:OS1_64>
    
    <!-- livox lidar -->
    <link name="livox_lidar_link"/>
    <joint name="livox_lidar_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['livox_lidar_link']['x']}
             ${calibration['sensor_kit_base_link']['livox_lidar_link']['y']}
             ${calibration['sensor_kit_base_link']['livox_lidar_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['livox_lidar_link']['roll']}
             ${calibration['sensor_kit_base_link']['livox_lidar_link']['pitch']}
             ${calibration['sensor_kit_base_link']['livox_lidar_link']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="livox_lidar_link"/>
    </joint>

    <!-- camera -->
    <xacro:monocular_camera_macro
      name="front_left_corner_camera"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['front_left_corner_camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['front_left_corner_camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['front_left_corner_camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['front_left_corner_camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['front_left_corner_camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['front_left_corner_camera_link']['yaw']}"
      fps="30"
      width="800"
      height="400"
      fov="1.3"
    />
    <xacro:monocular_camera_macro
      name="front_right_corner_camera"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['front_right_corner_camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['front_right_corner_camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['front_right_corner_camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['front_right_corner_camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['front_right_corner_camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['front_right_corner_camera_link']['yaw']}"
      fps="30"
      width="800"
      height="400"
      fov="1.3"
    />
    <xacro:monocular_camera_macro
      name="rear_right_corner_camera"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['rear_right_corner_camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['rear_right_corner_camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['rear_right_corner_camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['rear_right_corner_camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['rear_right_corner_camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['rear_right_corner_camera_link']['yaw']}"
      fps="30"
      width="800"
      height="400"
      fov="1.3"
    />
    <xacro:monocular_camera_macro
      name="rear_left_corner_camera"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['rear_left_corner_camera_link']['x']}"
      y="${calibration['sensor_kit_base_link']['rear_left_corner_camera_link']['y']}"
      z="${calibration['sensor_kit_base_link']['rear_left_corner_camera_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['rear_left_corner_camera_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['rear_left_corner_camera_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['rear_left_corner_camera_link']['yaw']}"
      fps="30"
      width="800"
      height="400"
      fov="1.3"
    />
    <xacro:monocular_camera_macro
      name="oak"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['oak_link']['x']}"
      y="${calibration['sensor_kit_base_link']['oak_link']['y']}"
      z="${calibration['sensor_kit_base_link']['oak_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['oak_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['oak_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['oak_link']['yaw']}"
      fps="30"
      width="800"
      height="400"
      fov="1.3"
    />

    <!-- gnss -->
    <xacro:imu_macro
      name="gnss"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['gnss_link']['x']}"
      y="${calibration['sensor_kit_base_link']['gnss_link']['y']}"
      z="${calibration['sensor_kit_base_link']['gnss_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['gnss_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['gnss_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['gnss_link']['yaw']}"
      fps="100"
    />

    <!-- imu -->
    <xacro:imu_macro
      name="imu"
      parent="sensor_kit_base_link"
      namespace=""
      x="${calibration['sensor_kit_base_link']['imu_link']['x']}"
      y="${calibration['sensor_kit_base_link']['imu_link']['y']}"
      z="${calibration['sensor_kit_base_link']['imu_link']['z']}"
      roll="${calibration['sensor_kit_base_link']['imu_link']['roll']}"
      pitch="${calibration['sensor_kit_base_link']['imu_link']['pitch']}"
      yaw="${calibration['sensor_kit_base_link']['imu_link']['yaw']}"
      fps="100"
    />
  </xacro:macro>
</robot>
